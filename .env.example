NODE_ENV=development
DATABASE_URL=postgresql://sitra:sitra_dev_password@localhost:5432/sitra_ia?schema=public
# Optional direct (non-pooled) connection used only for migrations, e.g. Neon.
DATABASE_URL_UNPOOLED=
REDIS_URL=redis://localhost:6379
API_PORT=3001
# Origin(s) of the web app allowed to call the API (comma separated, no wildcard in production).
CORS_ORIGINS=http://localhost:3000
# Where the web app forwards /api/v1 (server-side rewrite). The browser always uses /api/v1.
SITRA_API_ORIGIN=http://localhost:3001
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SAME_SITE=Lax
SESSION_COOKIE_SECURE=false
# Number of proxy hops in front of the API (e.g. 1 behind a load balancer). Empty when exposed directly.
TRUST_PROXY=
WORKER_PORT=8000
AI_PROVIDER=
AI_API_KEY=
PRIVATE_DOCUMENTS_BUCKET=
