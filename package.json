{
  "name": "sitra-ia",
  "version": "0.2.0",
  "private": true,
  "description": "Sistema Inteligente de Trânsito e Recursos Administrativos",
  "workspaces": ["apps/web", "apps/api"],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run start:dev --workspace apps/api",
    "db:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker/docker-compose.yml down",
    "db:generate": "prisma generate --schema database/prisma/schema.prisma",
    "db:push": "prisma db push --schema database/prisma/schema.prisma",
    "db:studio": "prisma studio --schema database/prisma/schema.prisma"
  },
  "dependencies": {"@prisma/client": "^6.0.0"},
  "devDependencies": {"@types/node": "^22.0.0", "prisma": "^6.0.0", "typescript": "^5.7.0"}
}
